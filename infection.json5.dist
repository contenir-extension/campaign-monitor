{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "timeout": 10,
    "threads": "max",
    "logs": {
        "text": "infection.log",
        "summary": "summary.log",
        "stryker": {
            "badge": "/^(main|master)$/"
        }
    },
    "mutators": {
        "@default": true,
        "global-ignoreSourceCodeByRegex": [
            "if \\(function_exists\\('opcache_invalidate'\\)\\) \\{",
            "opcache_invalidate\\(\\$path, force: true\\);"
        ]
    },
    "staticAnalysisTool": "mago"
}

